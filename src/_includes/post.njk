---
layout: base.njk
---

<header class="page-hero">
  <div class="container">
    <div class="kicker">{{ page.date | niceDate }}</div>
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="section-lead">{{ description }}</p>
    {% endif %}
  </div>
</header>

<article class="block post">
  <div class="container post-container">
    <div class="post-body">{{ content | safe }}</div>
    <a class="btn-link" href="/news/">← Все новости</a>
  </div>
</article>
