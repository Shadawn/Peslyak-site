---
layout: base.njk
title: Новости
---

<header class="page-hero">
  <div class="container">
    <div class="kicker">Новости</div>
    <h1>Новости кампании</h1>
    <p class="section-lead">Последние новости от штаба Марины Песляк.</p>
  </div>
</header>

<section class="block">
  <div class="container">
    {% if collections.news | length > 0 %}
    <div class="news-grid">
      {% for post in collections.news %}
      <a class="news-card reveal" href="{{ post.url }}"{% if loop.index0 and loop.index0 < 4 %} data-delay="{{ loop.index0 }}"{% endif %}>
        {% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}">{% endif %}
        <span class="news-card-body">
          <span class="news-date">{{ post.date | niceDate }}</span>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          <span class="news-more">Читать →</span>
        </span>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p class="news-empty">Новостей пока нет — скоро появятся.</p>
    {% endif %}
  </div>
</section>
