<!-- News -->
<section class="block news-section" id="news">
  <div class="container">
    <div class="kicker reveal">Новости</div>
    <h2 class="reveal">Новости кампании</h2>
    {% if collections.news | length > 0 %}
    <div class="news-grid">
      {% for post in collections.news %}{% if loop.index <= 3 %}
      <a class="news-card reveal" href="{{ post.url }}"{% if loop.index0 %} data-delay="{{ loop.index0 }}"{% endif %}>
        {% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}">{% endif %}
        <span class="news-card-body">
          <span class="news-date">{{ post.date | niceDate }}</span>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          <span class="news-more">Читать →</span>
        </span>
      </a>
      {% endif %}{% endfor %}
    </div>
    <div class="news-all reveal"><a class="btn-link" href="/news/">Все новости →</a></div>
    {% else %}
    <p class="news-empty reveal">Новостей пока нет — скоро появятся.</p>
    {% endif %}
  </div>
</section>

